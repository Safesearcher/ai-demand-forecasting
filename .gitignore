# ─── Credentials (NEVER commit these) ───────────────────────────
kaggle.json
.env
api
api.txt

# ─── Archive folder (credentials + out-of-scope code) ────────────
_archive/

# ─── Data folders & specific exceptions ───────────────────────────
data/raw/*
!data/raw/.gitkeep
!data/raw/acquisition_log.json
!data/raw/acquisition_log.txt

data/processed/*
!data/processed/.gitkeep
!data/processed/cleaning_report.json
!data/processed/feature_config.json

# ─── Data and model file extensions ──────────────────────────────
*.csv
*.zip
*.parquet
*.sqlite
*.db
*.pkl
*.joblib

# ─── Model artifacts ──────────────────────────────────────────────
models/*
!models/scalers/
models/scalers/*
!models/scalers/.gitkeep

# ─── Report & deliverables ────────────────────────────────────────
# Ignore intermediate draft copies, build artifacts, and auxiliary PDFs
report/* (1).*
report/main_fixed.*
report/*.pdf

# Ensure report figures and final deliverable PDF are allowed
!report/figures/
!report/figures/*
!report/*.tex
!report/Deliverable1_Report.pdf
!report/.gitkeep

# ─── LaTeX build artefacts ────────────────────────────────────────
*.aux
*.log
*.out
*.fls
*.fdb_latexmk
*.toc
*.synctex.gz
*.bbl
*.blg
*.nav
*.snm
*.vrb

# ─── Python & environments ────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
.venv/
venv/
ENV/

# ─── Jupyter & IDEs ───────────────────────────────────────────────
.ipynb_checkpoints/
.vscode/
.idea/
*.swp
*.swo
*~
